# Minimal .env consumed by CI — never used at runtime in production.
# Provides just enough config for bootstrap to succeed; the tests do not connect to a DB.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ci_stub
DB_USER=ci
DB_PASS=ci
DB_CHARSET=utf8mb4

APP_NAME=Fronote-CI
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
BASE_URL=

CSRF_LIFETIME=3600
CSRF_MAX_TOKENS=10
SESSION_NAME=pronote_ci
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DECAY=1

JWT_SECRET=ci-only-not-a-real-secret-do-not-use-anywhere-else
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

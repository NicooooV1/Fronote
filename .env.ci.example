# ============================================================================
# Fronote — configuration d'INTÉGRATION CONTINUE (throwaway, NON secrète).
# Copiée en .env par la CI (cp .env.ci.example .env). Ne jamais utiliser en prod.
# APP_ENV=testing désactive le fail-fast du ProductionReadinessChecker.
# ============================================================================
APP_NAME="Fronote CI"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_BASE_PATH=/
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fronote_ci
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Secrets jetables de CI : remplacer chaque valeur par un secret 32 octets généré
# localement (ne jamais committer de vraie valeur) : openssl rand -hex 32
APP_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
WEBSOCKET_API_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

SESSION_NAME=fronote_ci
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
TRUST_PROXY_HEADERS=false

WEBSOCKET_ENABLED=false
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
CACHE_DRIVER=file

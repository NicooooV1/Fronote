# ============================================================================
# Fronote — configuration d'INTÉGRATION CONTINUE (throwaway, NON secrète).
# Copiée en .env par la CI (cp .env.ci.example .env). Ne jamais utiliser en prod.
# APP_ENV=testing désactive le fail-fast du ProductionReadinessChecker.
# ============================================================================
APP_NAME="Fronote CI"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_BASE_PATH=/
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fronote_ci
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Secrets jetables de CI (générés à la création du fichier, sans valeur en prod).
APP_KEY=d13784bf9c12c9e3494688fc4578f35e297fc11a9e66cf5bb2dc3319947f501a
JWT_SECRET=a8cf8e4d32d59e54fd6b809535e43ae90cdb3a0d685fd4334b78fdcd61603f23
WEBSOCKET_API_SECRET=67350f2f58c6538b0b88b4286c519c8276142b11ed16dfda3b135b5c534f6056

SESSION_NAME=fronote_ci
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
TRUST_PROXY_HEADERS=false

WEBSOCKET_ENABLED=false
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
CACHE_DRIVER=file

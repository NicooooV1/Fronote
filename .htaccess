# ============================================================================
# Fronote — Configuration Apache (racine)
# Durcissement production : blocage des fichiers/dossiers sensibles, compression,
# cache navigateur, en-têtes de sécurité. Compatible Apache 2.4 (avec repli 2.2).
# ============================================================================

Options -Indexes

# --- Blocage des dépôts de gestion de version, dotfiles, et fichiers sensibles ---
RedirectMatch 404 (?i)/\.(git|svn|hg|bzr)(/|$)
RedirectMatch 404 (?i)/\.env
RedirectMatch 404 (?i)/(composer|package)(-lock)?\.(json|lock)$
RedirectMatch 404 (?i)/.*\.(sql|sqlite|db|bak|ini|conf|log|lock|yml|yaml|sh|dist|example|md)$
RedirectMatch 404 (?i)/install\.php(\.[a-z0-9.-]+)?$

# --- Blocage des dossiers internes (non destinés au web) ---
RedirectMatch 404 (?i)/(vendor|logs|storage|database|scripts|config|tests|node_modules|websocket|\.github|lang|cron|docs|ltr)(/|$)

# --- Non-exposition des fichiers de LIBRAIRIE PHP (équivaut à un docroot public/ sans
#     déplacer les fichiers) : classes, bootstrap, includes, templates ne sont jamais
#     servis directement — ils sont inclus par les entrypoints. Seul API/endpoints/
#     (points d'entrée AJAX) reste accessible sous API/. Empêche l'accès HTTP direct à
#     API/bootstrap.php, API/Legacy/Bridge.php, modules/*/includes/*, templates/*, etc. ---
RedirectMatch 404 (?i)^/API/(?!endpoints/)[^?]*\.php$
RedirectMatch 404 (?i)^/modules/[^/]+/(includes|Services|Database|Events|Providers|Jobs|Widgets|Http|Domain|Support|Repositories|views)/
RedirectMatch 404 (?i)^/templates/[^?]*\.php$

# --- Repli par motif de nom de fichier (si RedirectMatch indisponible) ---
<FilesMatch "(?i)^(\.env.*|.*\.(sql|sqlite|db|bak|ini|conf|log|lock|yml|yaml|sh|dist|example|md|neon)|composer\.(json|lock)|package(-lock)?\.json|install\.php|Dockerfile|docker-compose\.yml|version\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- En-têtes de sécurité (la CSP est gérée côté PHP) ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Anti-fingerprinting : retirer la bannière de version PHP (expose_php n'est
    # pas forçable au runtime ; on la supprime au niveau Apache).
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HSTS : sans effet en HTTP clair, actif dès que le site passe en HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# --- Redirection HTTPS (à ACTIVER lors de l'exposition hors LAN) ---
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Cache navigateur (les assets sont versionnés par ?v=mtime) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Portail établissement (refonte 3-mondes) : URLs propres /e/{slug}/... ---
# /e/{slug} → tableau de bord ; /e/{slug}/{login|dashboard|admin|logout} → page tenant.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^e/([A-Za-z0-9_-]+)/?$ tenant/dashboard.php?e=$1 [L,QSA]
    RewriteRule ^e/([A-Za-z0-9_-]+)/(login|dashboard|admin|logout)/?$ tenant/$2.php?e=$1 [L,QSA]
</IfModule>

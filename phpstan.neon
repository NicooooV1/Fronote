# Analyse statique Fronote — BLOQUANTE en CI : la baseline (phpstan-baseline.neon) fige la
# dette existante ; toute NOUVELLE erreur fait échouer le build. Pour monter le niveau
# (3 → 6), régénérer la baseline : phpstan analyse --generate-baseline phpstan-baseline.neon
includes:
    - phpstan-baseline.neon

parameters:
    level: 3
    paths:
        - API
        - modules
        - admin
        - rgpd
        - platform
        - tenant
    excludePaths:
        - vendor/*
        - tests/*
        - */Database/*
        - */lang/*
    # La couche legacy expose des fonctions globales (Bridge.php) résolues au runtime.
    scanFiles:
        - API/Legacy/Bridge.php
        - API/Core/helpers.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

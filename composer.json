{
  "name": "fronote/fronote",
  "description": "Fronote – Système de gestion scolaire",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-sodium": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml"
  },
  "autoload": {
    "psr-4": {
      "API\\": "API/",
      "Pronote\\": "API/",
      "Modules\\": "modules/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

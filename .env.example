# Exemple de configuration Fronote - Ce fichier sera généré automatiquement lors de l'installation.
# NE PAS MODIFIER MANUELLEMENT, utilisez install.php pour générer ce fichier.

# Sécurité installation
ALLOWED_INSTALL_IP=

# Base de données
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Application
APP_NAME="Fronote"
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_BASE_PATH=
BASE_URL=

# Sécurité
CSRF_LIFETIME=3600
CSRF_MAX_TOKENS=10

# Sessions
SESSION_NAME=pronote_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Connexion
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Rate limiting
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DECAY=1

# Chemins
LOGS_PATH=
UPLOADS_PATH=
TEMP_PATH=

# Mail (à configurer après installation)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Fronote"

# Timezone
APP_TIMEZONE=Europe/Paris

# Audit
AUDIT_RETENTION_DAYS=180
AUDIT_ENABLED=true

# Monitoring — protège /API/endpoints/health.php (sinon : version PHP, disque, état DB exposés).
# Vide en production = l'endpoint ne renvoie qu'un statut binaire {healthy:bool}, sans détails.
# Générer : php -r "echo bin2hex(random_bytes(16));"
HEALTH_TOKEN=

# ==================================================
# WEBSOCKET
# ==================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_URL=http://localhost:3000
WEBSOCKET_CLIENT_URL=http://localhost:3000
# OBLIGATOIRES : le serveur WS refuse de démarrer sans ces secrets (plus aucune
# valeur par défaut codée en dur). Générer : php -r "echo bin2hex(random_bytes(32));"
WEBSOCKET_API_SECRET=your_secure_secret_here
JWT_SECRET=your_jwt_secret_here
# Origines CORS autorisées pour le serveur WebSocket (liste séparée par des virgules,
# ex. https://ecole.example.fr). Laisser vide = aucune origine navigateur autorisée.
WEBSOCKET_ALLOWED_ORIGINS=

# APP_KEY — clé applicative maître (générée automatiquement par install.php).
# Sert au HMAC des cookies signés, au chiffrement at-rest et au chiffrement des
# sauvegardes. Générer 64 caractères hex : `php -r "echo bin2hex(random_bytes(32));"`.
# En son absence, le système retombe sur JWT_SECRET.
APP_KEY=
# Honorer X-Forwarded-Proto/SSL (HTTPS derrière reverse-proxy). true UNIQUEMENT
# si un proxy de confiance fixe ces en-têtes, sinon ils sont spoofables.
TRUST_PROXY_HEADERS=false
# Chiffrer les sauvegardes SQL (contiennent des données personnelles). Défaut: oui
# si une clé est configurée. Mettre à false pour des dumps en clair (déconseillé).
BACKUP_ENCRYPT=true

# ==================================================
# MISE À JOUR (bouton unique — admin/systeme/update.php)
# ==================================================
# Le bouton « Mettre à jour » fait : git fetch + git reset --hard origin/<branche>
# + réconciliation du schéma SQL (SchemaSyncService, SANS migration) + resync des
# modules + vidage du cache. Aucun webhook, aucun déploiement automatique.
#
# Branche Git suivie par la mise à jour :
GITHUB_BRANCH=main
# Chemin du binaire git si absent du PATH du serveur web (ex. Windows/XAMPP).
# Laisser 'git' s'il est dans le PATH.
GIT_BINARY=git

# ==================================================
# INTERNATIONALISATION
# ==================================================
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# ==================================================
# API EXTERNE
# ==================================================
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=60

# ==================================================
# CACHE
# ==================================================
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==================================================
# SSO / OAUTH2
# ==================================================
OAUTH_PROVIDER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
OAUTH_SCOPES=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=

# ==================================================
# BACKUP
# ==================================================
BACKUP_RETENTION=5